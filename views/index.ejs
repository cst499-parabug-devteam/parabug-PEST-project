<!DOCTYPE html>
<html>
  <head>
    <title>Parabug Estimate Solution Tool</title>
    <meta name="viewport" content="initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
    <link rel="stylesheet" type="text/css" href="stylesheets/bootstrap-4.0.0.min.css">
    <link rel="stylesheet" type="text/css" href="stylesheets/style.css">
    <script src="/js/jquery-3.5.1.min.js"></script>
    <script src="/js/popper-1.12.9.min.js"></script>
    <script src="/js/bootstrap-4.0.0.min.js"></script>
    <script defer src="/vendor/terra-draw/terra-draw.umd.js"></script>
    <script defer src="/vendor/terra-draw-google-maps-adapter/terra-draw-google-maps-adapter.umd.js"></script>
    <script defer src="/vendor/jsts/jsts.min.js"></script>
    <script
      defer
      src="https://maps.googleapis.com/maps/api/js?key=<%= api_key %>&callback=initMap&libraries=places,geometry"
    ></script>
    <script src="/js/toGeoJson.js"></script>
    <script src="/js/geoxml3.js"></script>
    <script src="/js/ZipFile.js"></script>
    <script defer src="/js/ProtectedOverlay.js"></script>
    <script defer src="/js/classes.js"></script>
    <script src="/js/geotiff.js"></script>
    <script src="/js/proj4.js"></script>
    <script src="./js/esri-proj-codes.js"></script>
    <script src="./js/tiff.js"></script>
    <script src="./js/shapefile.js"></script>
    <script src="./js/jszip.js"></script>
    <script defer src="./js/geolocation-marker.js"></script>
  </head>

  <body>
    <div class="map-container">
      <div id="map"></div>
      <input id="pac-input" class="controls" type="text" placeholder="Search..." aria-label="Search map" hidden/>
      <div class="row" id="advanced-options">
        <div class="col col-auto" id="advanced-options-button-tab">
          <button type="button" id="advanced-options-button" aria-label="Toggle Draw Settings" aria-expanded="false">
            <span class="draw-settings-chevron" aria-hidden="true"></span>
          </button>
        </div>
        <div id="advanced-options-controls">
          <div class="row justify-content-center mt-2 mb-1">
            <div class="col col-auto"><h4>Draw Settings</h4></div>
          </div>
          
          <details class="draw-setting-details">
            <summary class="draw-setting-summary">
              <span class="draw-setting-name">Application Area</span>
              <span class="draw-setting-meta">
                <span class="draw-setting-swatch" id="app-area-swatch" style="background-color: #FFFF00"></span>
                <span class="draw-setting-opacity" id="app-area-opacity-display">60%</span>
              </span>
            </summary>
            <div class="draw-setting-editor">
              <label class="draw-setting-field"><span>Color</span><input type="color" id="app-area-color" value="#FFFF00"></label>
              <label class="draw-setting-field"><span>Opacity</span><span class="draw-setting-range"><input type="range" min="0" max="100" value="60" id="app-area-opacity"></span></label>
            </div>
          </details>

          <details class="draw-setting-details">
            <summary class="draw-setting-summary">
              <span class="draw-setting-name">Hazard Area</span>
              <span class="draw-setting-meta">
                <span class="draw-setting-swatch" id="hazard-area-swatch" style="background-color: #FF0000"></span>
                <span class="draw-setting-opacity" id="hazard-area-opacity-display">70%</span>
              </span>
            </summary>
            <div class="draw-setting-editor">
              <label class="draw-setting-field"><span>Color</span><input type="color" id="hazard-area-color" value="#FF0000"></label>
              <label class="draw-setting-field"><span>Opacity</span><span class="draw-setting-range"><input type="range" min="0" max="100" value="70" id="hazard-area-opacity"></span></label>
            </div>
          </details>

          <details class="draw-setting-details">
            <summary class="draw-setting-summary">
              <span class="draw-setting-name">Variable Rate Area</span>
              <span class="draw-setting-meta">
                <span class="draw-setting-swatch" id="vr-area-swatch" style="background-color: #CCCCCC"></span>
                <span class="draw-setting-opacity" id="vr-area-opacity-display">60%</span>
              </span>
            </summary>
            <div class="draw-setting-editor">
              <label class="draw-setting-field"><span>Color</span><input type="color" id="vr-area-color" value="#CCCCCC"></label>
              <label class="draw-setting-field"><span>Opacity</span><span class="draw-setting-range"><input type="range" min="0" max="100" value="60" id="vr-area-opacity"></span></label>
            </div>
          </details>

          <div class="row justify-content-center mt-2">
            <div class="col col-auto"><input type="button" class="btn btn-outline-primary" value="Reset Draw Settings" onclick="resetDisplaySettings()"></div>
          </div>
          <div id="overlay-settings" class="mt-4">
            <div class="row justify-content-center mb-1">
              <div class="col col-auto"><h4>Overlay Settings</h4></div>
            </div>
            <div id="overlay-settings-content"></div>
            <div class="row align-items-center justify-content-center mt-2">
              <div class="col col-auto">Overlay Display: </div>
              <div class="col col-auto"><input type="button" class="btn btn-outline-primary" value="Off" onclick="setOverlayVisibility(false)"></div>
              <div class="col col-auto"><input type="button" class="btn btn-outline-primary" value="On" onclick="setOverlayVisibility(true)"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div id="top-alert"></div>


    <header class="request-toolbar">
      <div class="request-brand">
        <img id="logo-img" src="/img/logo-sml.jpg" alt="Parabug" />
        <h1>Application request</h1>
      </div>
      <div class="request-actions">
      <div id="session-options-dropdown">
        <button id="session-options-dropdown-btn" onclick="showSessionOptions()"
          title="Save/Import map and form data. Does not save overlays imported onto the map or uploaded ranch map files.">
          Session
        </button>
        <div id="session-options-dropdown-content">
          <a onclick="importSession()">Import</a>
          <a onclick="exportSession()">Save</a>
        </div>
      </div>
      <button type="button" id="help-menu-button" onclick="showHelp()" aria-haspopup="dialog">
        <img src="https://cdn.jsdelivr.net/npm/lucide-static@0.468.0/icons/circle-help.svg" width="18" height="18" alt="">
        Help
      </button>
      </div>
    </header>

    <form id="additional-info" method="POST" enctype="multipart/form-data">
      <div id="stat-display">
        <div class="rates-header">
          <h2>Application rates</h2>
          <label class="rate-toggle" for="add-bug-toggle">
            <input type="checkbox" name="add-bug-toggle" id="add-bug-toggle" value="add-bug"/>
            <span>Second bug</span>
          </label>
        </div>
  
        <!--Bug Name-->
        <div class="stat-item">
          <label class="stat-text" for="bug-name" title="Bug Indicator">Bug</label>
          <div class="stat-input">
            <input type="text" name="bug-name" id="bug-name" />
          </div>
        </div>
  
        <!--Bugs Per Acre-->
        <div class="stat-item">
          <label class="stat-text" for="num-bugs-per-acre" title="Bugs per acre in the application area">Bugs / acre<span class="required">*</span></label>
          <div class="stat-input">
            <input type="number" name="bugs-per-acre" id="num-bugs-per-acre" min="1" value="10000" required/>
          </div>
        </div>
  
        <!--Variable Rate-->
        <div class="stat-item">
          <label class="stat-text" for="variable-rate" title="Bugs per acre in variable rate areas">Variable rate</label>
          <div class="stat-input">
            <input type="number" name="variable-rate" id="variable-rate" value="20000" min="0"/>
          </div>
        </div>
  
        <div id="add-bug-display">
  
          <!--Bug Name 2-->
          <div class="stat-item">
            <label class="stat-text" for="bug-name2" title="Bug Indicator">Second bug</label>
            <div class="stat-input">
              <input type="text" name="bug-name2" id="bug-name2" />
            </div>
          </div>
  
          <!--Bugs Per Acre 2-->
          <div class="stat-item">
            <label class="stat-text" for="num-bugs-per-acre2" title="Bugs per acre in the application area">Bugs / acre<span class="required">*</span></label>
            <div class="stat-input">
              <input type="number" name="bugs-per-acre2" id="num-bugs-per-acre2" min="1" value="10000" required/>
            </div>
          </div>
  
          <!--Variable Rate 2-->
          <div class="stat-item">
            <label class="stat-text" for="variable-rate2" title="Bugs per acre in variable rate areas">Variable rate</label>
            <div class="stat-input">
              <input type="number" name="variable-rate2" id="variable-rate2" value="20000" min="0"/>
            </div>
          </div>
        </div>
  
        <!--Estimated Number of Acres-->
        <div class="stat-item estimate-field">
          <label class="stat-text" for="num-acres"
            title="Estimated number acres = application area - sum(hazard areas). If incorrect fill in manual acreage value">
            Estimated acres
          </label>
          <div class="stat-input">
            <input type="number" name="num-acres" id="num-acres" class="read-only" value="0" readonly/>
          </div>
        </div>
  
        <!--Estimated Total Bugs-->
        <div class="stat-item estimate-field">
          <label class="stat-text" for="num-bugs-display" title="Estimated total number of bugs">Total bugs</label>
          <div class="stat-input">
            <input type="hidden" name="num-bugs" id="num-bugs" value="0"/>
            <input type="text" id="num-bugs-display" class="read-only" value="0" readonly/>
          </div>
        </div>
  
      </div>
  
      <div id="mobile-div">
        <div id="mobile-mode-div">
          <label class="crosshair-icon-toggle" for="mobile-mode" title="Toggle Crosshair mode">
            <input type="checkbox" value="mobile" id="mobile-mode" name="mobile-mode" aria-label="Crosshair mode"/>
            <span class="crosshair-icon-frame" aria-hidden="true"></span>
          </label>
        </div>
        <div id="mobile-options-div">
          <button type="button" class="crosshair-action" onClick="makeMarker()" aria-label="Mark / Select" title="Mark / Select">
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="5.5"></circle>
              <circle cx="12" cy="12" r="1.5"></circle>
              <path d="M12 1.5v4M12 18.5v4M1.5 12h4M18.5 12h4"></path>
            </svg>
          </button>
          <button type="button" class="crosshair-action" onClick="finishShape()" aria-label="Finish" title="Finish">
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="m4.5 12.5 5 5L19.5 6.5"></path>
            </svg>
          </button>
        </div>
      </div>
  
      <div id="user-info-display">
        <div class="align-input">
          <fieldset class="form-fieldset" id="user-info-fields">
            <legend>Contact details</legend>
  
            <!--Contact Name-->
            <div class="form-element">
              <label class="form-text" for="contact-name">
                Contact Name<span class="required">*</span>
              </label>
              <div class="form-input">
                <input type="text" name="contact_name" id="contact-name" autocomplete="name" required/>
              </div>
            </div>
  
            <!--Contact Phone-->
            <div class="form-element">
              <label class="form-text" for="contact-phone">
                Contact Phone<span class="required">*</span>
              </label>
              <div class="form-input">
                <input type="tel" name="contact_phone" id="contact-phone" autocomplete="tel" required/>
              </div>
            </div>
  
            <!--Contact Email-->
            <div class="form-element">
              <label class="form-text" for="contact-email">
                Contact Email<span class="required">*</span>
              </label>
              <div class="form-input">
                <input type="email" name="contact_email" id="contact-email" autocomplete="email" required/>
              </div>
            </div>
  
            <!--Billing Address-->
            <div class="form-element">
              <label class="form-text" for="billing-address">
                Billing Address<span class="required">*</span>
              </label>
              <div class="form-input">
                <input type="text" name="billing_address" id="billing-address" autocomplete="street-address" required />
              </div>
            </div>
          </fieldset>
  
          <fieldset class="form-fieldset" id="application-area-fields">
            <legend>Application area</legend>
  
            <!--Crop-->
            <div class="form-element">
              <label class="form-text" for="crop">
                <a class="click-tip" href="#help-field-crop" onclick="event.preventDefault(); showPrompt('crop')">Crop</a>
                <span class="required">*</span>
              </label>
              <div class="form-input">
                <input type="text" name="crop" id="crop" required/>
              </div>
            </div>
  
            <!--Row Spacing-->
            <div class="form-element">
              <label class="form-text" for="row-spacing">
                <a class="click-tip" href="#help-field-row-spacing" onclick="event.preventDefault(); showPrompt('row-spacing')">Spacing (ft)</a>
                <span class="required">*</span>
              </label>
              <div class="form-input">
                <input type="number" step="0.01" name="row_spacing" id="row-spacing" required/>
              </div>
            </div>
  
            <!-- Ranch Name -->
            <div class="form-element">
              <label class="form-text" for="ranch-name">
                Ranch Name
                <span class="required">*</span>
              </label>
              <div class="form-input">
                <input type="text" name="ranch-name" id="ranch-name" required/>
              </div>
            </div>
  
            <!-- Corrected Acreage -->
            <div class="form-element">
              <label class="form-text" for="corrected-acreage">
                <a class="click-tip" href="#help-field-corrected-acreage" onclick="event.preventDefault(); showPrompt('corrected-acreage')">Manual Acreage</a>
              </label>
              <div class="form-input">
                <input type="number" step="0.01" name="corrected-acreage" id="corrected-acreage"/>
              </div>
            </div>

            <!-- Ranch Map -->
            <div class="form-element">
              <label class="form-text" for="ranch-map">
                <a class="click-tip" href="#help-field-ranch-map" onclick="event.preventDefault(); showPrompt('ranch-map')">Ranch Map</a>
              </label>
              <div class="form-input">
                <input type="file" name="ranch-map" id="ranch-map" accept="image/jpeg, image/png, .pdf">
              </div>
            </div>
          </fieldset>
  
          <fieldset class="form-fieldset" id="user-preference-fields">
            <legend>Preferences</legend>
  
            <!-- Desired Application Date -->
            <div class="form-element">
              <label class="form-text" for="application-date">
                <a class="click-tip" href="#help-field-application-date" onclick="event.preventDefault(); showPrompt('application-date')">Application Date</a>
              </label>
              <div class="form-input">
                <input type="date" name="application-date" id="application-date"/>
              </div>
            </div>
  
            <!-- Operator Preference -->
            <div class="form-element">
              <label class="form-text" for="operator">
                <a class="click-tip" href="#help-field-operator" onclick="event.preventDefault(); showPrompt('operator')">Operator</a>
              </label>
              <div class="form-input">
                <input type="text" name="operator" id="operator"/>
              </div>
            </div>
  
            <!-- Notes -->
            <div class="form-element">
              <label class="form-text" for="notes">
                <a class="click-tip" href="#help-field-notes" onclick="event.preventDefault(); showPrompt('notes')">Notes</a>
              </label>
              <div class="form-input">
                <textarea name="notes" id="notes" rows="3"></textarea>
              </div>
            </div>
          </fieldset>
  
        </div>
  
        <div class="form-element" id="submitRequest">
          <div class="form-input">
            <button type="submit" class="request-submit">Submit request</button>
          </div>
        </div>
      </div>
    </form>

    <dialog id="help-dialog" aria-labelledby="help-title">
      <div class="help-navigation">
      <header class="help-header">
        <h2 id="help-title">Help</h2>
        <form method="dialog"><button type="submit" class="help-close" aria-label="Close help" title="Close help">&times;</button></form>
      </header>
      <div class="help-tabs" role="tablist" aria-label="Help topics">
        <button type="button" id="help-drawing-tab" role="tab" aria-selected="true" aria-controls="help-drawing" tabindex="0">Drawing</button>
        <button type="button" id="help-files-tab" role="tab" aria-selected="false" aria-controls="help-files" tabindex="-1">Files</button>
        <button type="button" id="help-fields-tab" role="tab" aria-selected="false" aria-controls="help-fields" tabindex="-1">Form fields</button>
        <button type="button" id="help-shortcuts-tab" role="tab" aria-selected="false" aria-controls="help-shortcuts" tabindex="-1">Shortcuts</button>
      </div>
      </div>
      <section id="help-drawing" class="help-panel" role="tabpanel" aria-labelledby="help-drawing-tab" tabindex="0">
        <h3>Draw an application area</h3>
        <ol>
          <li>Choose <strong>Application Area</strong> in the map's Mode dropdown.</li>
          <li>Click to place each corner of the boundary.</li>
          <li>Click the first point again to close and finish the polygon.</li>
        </ol>
        <p class="help-note"><strong>Cancel a draft:</strong> right-click while drawing to discard the unfinished shape. Completed areas stay unchanged, and the drawing tool remains active.</p>
        <h3>Hazards and variable rates</h3>
        <p>Create an application area first, then select <strong>Hazard</strong> or <strong>Variable Rate Area</strong>. Hazards exclude acreage from treatment; variable rate areas use the separate Variable Rate value.</p>
        <p>Use <strong>Delete</strong> mode and click an area to select it for deletion. Drawing a new application area resets the existing map areas.</p>
        <h3>Crosshair drawing</h3>
        <p>Turn on Crosshair mode in the lower-left map controls. Move the map to position the crosshair, use <strong>Mark / Select</strong> to place points, then <strong>Finish Shape</strong> to complete the boundary.</p>
        <h3>Appearance and navigation</h3>
        <p>Use <strong>Draw Settings</strong> on the right edge to change each area's color and opacity. Choose <strong>Drag</strong> to navigate without drawing, or open the search icon beside Mode to find a location.</p>
      </section>
      <section id="help-files" class="help-panel" role="tabpanel" aria-labelledby="help-files-tab" tabindex="0" hidden>
        <h3>Save and resume a session</h3>
        <p><strong>Session &gt; Save</strong> downloads a JSON backup of your application area, hazards, variable rate areas, and form entries. Use <strong>Session &gt; Import</strong> to restore a previously saved session JSON file.</p>
        <p class="help-note"><strong>Not included in session backups:</strong> imported overlays and uploaded ranch-map attachments. Re-import or reattach these files when resuming your work.</p>
        <h3>Import map overlays</h3>
        <p>Use the map's <strong>Options</strong> menu to import an overlay. Supported extensions are <code>.kml</code>, <code>.kmz</code>, <code>.tif</code>, <code>.zip</code>, and <code>.json</code>. A ZIP shapefile should contain matching SHP and DBF files.</p>
        <p>Follow the overlay import prompts to position or configure the layer. Overlay files and saved session JSON files serve different purposes; use Session Import only for session backups.</p>
        <h3>Attach a ranch map</h3>
        <p>The <strong>Ranch Map</strong> field accepts JPEG, PNG, or PDF files up to 10 MB. This is a request attachment, not a map overlay or session backup.</p>
      </section>
      <section id="help-fields" class="help-panel" role="tabpanel" aria-labelledby="help-fields-tab" tabindex="0" hidden>
        <div class="help-field">
          <h3 id="help-field-crop" tabindex="-1">Crop</h3>
          <p>Enter the crop or crops grown in the application area.</p>
        </div>
        <div class="help-field">
          <h3 id="help-field-row-spacing" tabindex="-1">Spacing (ft)</h3>
          <p>Enter the distance, in feet, between rows of crops in the field.</p>
        </div>
        <div class="help-field">
          <h3 id="help-field-corrected-acreage" tabindex="-1">Manual acreage</h3>
          <p>If you know the exact field acreage, enter it here to use it instead of the estimated acreage.</p>
          <p class="help-note">When manual acreage is supplied, hazard and variable rate areas are not incorporated into the initial bug estimate. Your map data is still sent with the request.</p>
        </div>
        <div class="help-field">
          <h3 id="help-field-ranch-map" tabindex="-1">Ranch map</h3>
          <p>Attach a JPEG, PNG, or PDF showing the ranch or desired application area (10 MB maximum). An attachment can be supplied instead of a manually drawn application area. It is not imported as a map overlay or included in a saved session.</p>
        </div>
        <div class="help-field">
          <h3 id="help-field-application-date" tabindex="-1">Application date</h3>
          <p>Choose your preferred date for the application. This field is optional.</p>
        </div>
        <div class="help-field">
          <h3 id="help-field-operator" tabindex="-1">Operator</h3>
          <p>Enter a preferred Parabug operator's name, if you have one. This field is optional.</p>
        </div>
        <div class="help-field">
          <h3 id="help-field-notes" tabindex="-1">Notes</h3>
          <p>Add any other details or requests for the application. This field is optional.</p>
        </div>
      </section>
      <section id="help-shortcuts" class="help-panel" role="tabpanel" aria-labelledby="help-shortcuts-tab" tabindex="0" hidden>
        <p>Use these keys with the map focused, not while entering text in a form.</p>
        <table class="help-shortcuts-table">
          <caption class="sr-only">Map keyboard shortcuts</caption>
          <thead><tr><th scope="col">Key</th><th scope="col">Action</th></tr></thead>
          <tbody>
            <tr><td><kbd>1</kbd></td><td>Drag mode</td></tr>
            <tr><td><kbd>2</kbd></td><td>Application area</td></tr>
            <tr><td><kbd>3</kbd></td><td>Hazard area</td></tr>
            <tr><td><kbd>4</kbd></td><td>Variable rate area</td></tr>
            <tr><td><kbd>5</kbd></td><td>Delete mode</td></tr>
            <tr><td><kbd>6</kbd></td><td>Variable rate auto generation (requires an overlay)</td></tr>
            <tr><td><kbd>T</kbd></td><td>Toggle Crosshair mode</td></tr>
            <tr><td><kbd>S</kbd></td><td>Mark / Select in Crosshair mode</td></tr>
            <tr><td><kbd>F</kbd></td><td>Finish shape in Crosshair mode</td></tr>
          </tbody>
        </table>
        <p class="help-note"><strong>Right-click</strong> cancels an unfinished cursor-drawn shape. <kbd>Esc</kbd> closes this Help dialog.</p>
      </section>
    </dialog>

    <dialog id="overlay-loader-modal" aria-labelledby="overlay-loader-title" aria-describedby="overlay-loader-header">
      <header class="help-header">
        <div class="overlay-import-heading">
          <h2 id="overlay-loader-title">Import overlay</h2>
          <p id="overlay-loader-header"></p>
        </div>
        <button type="button" class="help-close" onclick="closeOverlayLoader()" aria-label="Close overlay import" title="Close overlay import">&times;</button>
      </header>
      <div id="overlay-loader-body"></div>
      <footer id="overlay-loader-footer">
        <button type="button" class="overlay-import-cancel" onclick="closeOverlayLoader()">Cancel</button>
        <button type="button" id="overlay-loader-import" onclick="importOverlayFromLoader()">Import overlay</button>
      </footer>
    </dialog>

    <script>
      "use strict"
      /* GLOBAL VARIABLES */
      let map;
      let terraDrawInstance;
      var appArea;
      let infoWindow;
      let centerMarker;
      let centerMarkerLastMoveEvent;
      let overlayMarkers = [];
      let tempShape;

      let userLocation = false;
      let userLocationMarker;
      let updatingViewBounds = false;
      let mapDisplayView = "satellite";
      let mapLabelsVisible = true;

      // Overlay > VRA Auto Generation and Maginifying Class for Color Selection
      let updatingMagnifier = false;
      let magnifyingGlass;
      let vraAutoGenerationEnabled = false;

      // An instance of the GMapsOverlay class to help manage overlay data and display
      let overlayManager;
    
      // Internal object to help manage toggling between our custom drawing modes
      let drawModeControl = {
        modes: [
          "Drag",
          "Application Area",
          "Hazard",
          "Variable Rate Area",
          "Delete",
          "VRA Auto Generation"
        ],
        hoverText: [
          "Drag map view",
          "Create an application area. \n- Redrawing will reset map.",
          "Create a hazard area. \n- Application area must exist to create hazard areas.",
          "Create a variable rate area. \n- Application area must exist to create variable rate areas. \n- Variable rate areas do not overlap with hazard areas.",
          "Delete selection tool for deleting application areas, hazard areas, and variable rate areas.",
          "Auto generates variable rate areas based on color selected on the current overlay layer. Requires an overlay to be imported."
        ],
        current: 0,
        getCurrent: function() {
          return this.modes[this.current];
        }
      };
    
      // HTML Elements
      let fileInput = document.createElement("input");
      fileInput.setAttribute("type", "file");
      fileInput.setAttribute("accept", ".kml,.kmz, .tif, .zip, .json");
      
      // Allow for importing of an application area from KML
      let sessionFileInput = document.createElement("input");
      sessionFileInput.setAttribute("type", "file");
      sessionFileInput.setAttribute("accept", ".json");
    
      /* FUNCTIONS */
      function updateDrawSettingSummaries() {
        ["app-area", "hazard-area", "vr-area"].forEach(function(settingsPrefix) {
          let colorInput = document.getElementById(settingsPrefix + "-color");
          let opacityInput = document.getElementById(settingsPrefix + "-opacity");
          document.getElementById(settingsPrefix + "-swatch").style.backgroundColor = colorInput.value;
          document.getElementById(settingsPrefix + "-opacity-display").textContent = opacityInput.value + "%";
        });
      }

      function applyDisplaySettings() {
        try {
          if (appArea) {
            appArea.poly.setOptions({
              fillColor: $('#app-area-color').val(),
              fillOpacity: ($('#app-area-opacity').val()/100)
            });
            for(let i = 0; i < appArea.getNumHazard(); i++) {
              appArea.getHazard(i).poly.setOptions({
                fillColor: $('#hazard-area-color').val(),
                fillOpacity: ($('#hazard-area-opacity').val()/100)
              });
            }
            for(let i = 0; i < appArea.getNumVariableRateAreas(); i++) {
              appArea.getVariableRateArea(i).poly.setOptions({
                fillColor: $('#vr-area-color').val(),
                fillOpacity: ($('#vr-area-opacity').val()/100)
              });
            }
          }
          // Static Values
          AppArea.fill = $('#app-area-color').val();
          AppArea.opacity = $('#app-area-opacity').val()/100;
          AppArea.hazardFill = $('#hazard-area-color').val();
          AppArea.hazardOpacity = $('#hazard-area-opacity').val()/100;
          AppArea.vrFill = $('#vr-area-color').val();
          AppArea.vrOpacity = $('#vr-area-opacity').val()/100;
        } catch (e) {
          console.log("Error when applying custom drawing display settings: " + e.message);
        }

        updateDrawSettingSummaries();
        updateTerraDrawPreviewStyles(drawModeControl.current);
        if (overlayManager) { overlayManager.applyDisplaySettings(); }
      }

      function getTerraDrawPreviewStyles(mode) {
        let settingsPrefix = "app-area";
        switch (parseInt(mode, 10)) {
          case 2:
            settingsPrefix = "hazard-area";
            break;
          case 3:
            settingsPrefix = "vr-area";
            break;
        }

        let fillColor = $("#" + settingsPrefix + "-color").val();
        let fillOpacity = parseInt($("#" + settingsPrefix + "-opacity").val(), 10) / 100;
        return {
          fillColor: fillColor,
          fillOpacity: fillOpacity,
          outlineColor: fillColor,
          outlineOpacity: 1,
          outlineWidth: 1
        };
      }

      function updateTerraDrawPreviewStyles(mode) {
        if (terraDrawInstance && mode >= 1 && mode <= 3) {
          terraDrawInstance.updateModeOptions("polygon", {
            styles: getTerraDrawPreviewStyles(mode)
          });
        }
      }
    
      function centerMap() {
        if (appArea == null) {
          return;
        }
        let center = appArea.getCentroid();
        if (center == null) {
          return;
        }
        map.setCenter(center);
        map.setZoom(15);
      }

      function closeOverlayLoader() {
        document.getElementById("overlay-loader-modal").close();
      }

      const overlayLoaderDialog = document.getElementById("overlay-loader-modal");
      overlayLoaderDialog.addEventListener("keydown", function(event) {
        if (event.key === "Escape") {
          event.preventDefault();
          closeOverlayLoader();
        }
      });
      overlayLoaderDialog.addEventListener("click", function(event) {
        if (event.target !== overlayLoaderDialog) { return; }
        let bounds = overlayLoaderDialog.getBoundingClientRect();
        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) {
          closeOverlayLoader();
        }
      });

      async function createAlert(message, duration, type="success", callback) {
          let alertBox = $('#top-alert');
          let alert = $('<div></div>');
          switch (type) {
              case "success":
                  alert.attr("class","alert alert-success");
                  break;
              case "info":
                  alert.attr("class","alert alert-info");
                  break;
              case "error": default:
                  message = "Error: " + message;
                  alert.attr("class","alert alert-danger");
                  break;
          }
          alert.text(message);
          alert.hide();
          alertBox.append(alert);
          alert.fadeIn("slow", function(){
              setTimeout(function(){ alert.fadeOut("slow"); }, duration);
              if (callback) { setTimeout(() => { callback(true); }, 500); }
          });
      }

      function deleteSubPoly() {
        if ((appArea != null) && (appArea.deleteIdentifier != null)) {
          let index = appArea.getIndexOfIdentifier(appArea.deleteIdentifier.id, appArea.deleteIdentifier.type);
          if (appArea.deleteIdentifier.type == "hazard") {
              appArea.removeHazard(index);
          } else if (appArea.deleteIdentifier.type = "variable") {
              appArea.removeVariableRateArea(index);
          }
          appArea.resetGlobals();
          updateStats();
        }
      }

      function draw(path) {
        let mode = drawModeControl.getCurrent();
        switch (mode) {
          case "Application Area":
            if (appArea) {
              try {
                appArea.del();
              } catch (e) {
                // Continue
              }
              appArea = new AppArea(map, path);
            } else {
              appArea = new AppArea(map, path);
            }
            break;
          case "Hazard":
            if (appArea == null) {
              console.log("No application area defined for hazard");
              return;
            }
            appArea.addHazard(path);
            break;
          case "Variable Rate Area":
            if (appArea == null) {
              console.log("No application area defined for variate rate area");
              return;
            }
            appArea.addVariableRate(path);
            break;
          default:
            break; // unexpected input
        }
        let success = validate();
        updateStats();
      }
    
      function drawToggle(mode) {
        if (appArea != null) {
          appArea.resetGlobals();
        }
    
        // Value defaults in string, parse the int value
        mode = parseInt(mode, 10);
        if (mode != 5) { hideMagnifier(); }
        switch (mode) {
          case 5:
            terraDrawInstance.setMode("idle");
            drawModeControl.current = mode;
            vraAutoGenerationEnabled = true;
            break;
            case 4:
              case 0:
            vraAutoGenerationEnabled = false;
            terraDrawInstance.setMode("idle");
            drawModeControl.current = mode;
            break;
          case 1: // Fall through
          case 2: // Fall through
          case 3:
            vraAutoGenerationEnabled = false;
            updateTerraDrawPreviewStyles(mode);
            if (document.getElementById("mobile-mode").checked) {
              terraDrawInstance.setMode("idle");
            } else {
              terraDrawInstance.setMode("polygon");
            }
            drawModeControl.current = mode;
            break;
          default:
            break; // unexpected input
        }
      }
      
      function finishShape() {
        if (!!tempShape) {
          draw(tempShape.getPath());
          tempShape.setMap(null);
        }
        overlayMarkers = [];
        tempShape = null;
      }

      function handleLocationError(browserHasGeolocation) {
        let message = browserHasGeolocation
          ? "Error: The Geolocation service failed."
          : "Error: Your browser doesn't support geolocation.";
        console.log(message);
        userLocation = false;
      }
    
      function importOverlay() {
        fileInput.click();
      }
    
      function initMap() {
        map = new google.maps.Map(document.getElementById("map"), {
          center: { lat: 36.677756, lng: -121.729448 }, // default
          zoom: 15,
          mapTypeId: "hybrid",
          mapTypeControl: false,
          streetViewControl: false,
          rotateControl: false
        });

        let image = {
          url: "/img/crosshair.png",
          size: new google.maps.Size(200, 200),
          origin: new google.maps.Point(0, 0),
          anchor: new google.maps.Point(100, 100)
        };
    
        centerMarker = new google.maps.Marker({
          position: map.getCenter(),
          icon: image,
          draggable: true,
          // map: map,
          zIndex: 3
        });
    
        google.maps.event.addListener(centerMarker, "drag", function(e) {
          // console.log(this);
          // console.log(e);
          // Set public values from mobile marker
          centerMarkerLastMoveEvent = e;
          magnifierMove(e);
        });
    
        map.addListener("projection_changed", function() {
          if (terraDrawInstance) {
            return;
          }

          terraDrawInstance = new terraDraw.TerraDraw({
            adapter: new terraDrawGoogleMapsAdapter.TerraDrawGoogleMapsAdapter({
              map: map,
              lib: google.maps
            }),
            modes: [
              new terraDraw.TerraDrawPolygonMode({
                styles: getTerraDrawPreviewStyles(drawModeControl.current)
              }),
              new terraDraw.TerraDrawRenderMode({ modeName: "idle", styles: {} })
            ]
          });

          terraDrawInstance.on("ready", function() {
            terraDrawInstance.setMode("idle");
          });

          terraDrawInstance.on("finish", function(id, context) {
            if (context.action === "draw") {
              var feature = terraDrawInstance.getSnapshot().find(function(candidate) {
                return candidate.id === id;
              });

              if (feature && feature.geometry.type === "Polygon") {
                var paths = feature.geometry.coordinates.map(function(ring) {
                  return ring.map(function(coordinate) {
                    return { lat: coordinate[1], lng: coordinate[0] };
                  });
                });
                draw(paths.length === 1 ? paths[0] : paths);
              }
            }

            terraDrawInstance.setMode("idle");
            terraDrawInstance.removeFeatures([id]);
            window.setTimeout(function() {
              if (
                !document.getElementById("mobile-mode").checked &&
                drawModeControl.current >= 1 &&
                drawModeControl.current <= 3
              ) {
                terraDrawInstance.setMode("polygon");
              }
            }, 0);
          });

          terraDrawInstance.start();
          document.getElementById("map").addEventListener("contextmenu", function(event) {
            if (
              terraDrawInstance.getMode() !== "polygon" ||
              terraDrawInstance.getModeState() !== "drawing"
            ) {
              return;
            }

            event.preventDefault();
            event.stopPropagation();
            terraDrawInstance.setMode("idle");
            terraDrawInstance.setMode("polygon");
          }, true);
        });
    
        map.setTilt(0);
    
        //*********************************** User Location ************************************
        // Try HTML5 geolocation.
        try {
          if (navigator.geolocation) {
            userLocation = true;
            navigator.geolocation.getCurrentPosition(
              function(position) {
                let pos = {
                  lat: position.coords.latitude,
                  lng: position.coords.longitude
                };
                
              },
              function() {
                handleLocationError(true);
              }
            );
          } else {
            // Browser doesn't support Geolocation
            handleLocationError(false);
          }
        } catch (e) {
          console.log(e);
        }
        //********************************* End User Location **********************************
    
        //************************************* Search Box *************************************
        // Create the search box and link it to the UI element.
        let input = document.getElementById("pac-input");
        let searchBox = new google.maps.places.SearchBox(input);
    
        // Bias the SearchBox results towards current map's viewport.
        map.addListener("bounds_changed", function(event) {
          if (!updatingViewBounds) {
            searchBox.setBounds(map.getBounds());
            updatingViewBounds = true;
            setTimeout(() => {
              // console.log(map.getBounds());
              updatingViewBounds = false;
            }, 500);
          }

        });
    
        // Listen for the event fired when the user selects a prediction
        searchBox.addListener("places_changed", function() {
          let places = searchBox.getPlaces();
          if (places.length == 0) {
            return;
          }
    
          // For each place, get the location.
          let bounds = new google.maps.LatLngBounds();
          places.forEach(function(place) {
            if (!place.geometry) {
              console.log("Returned place contains no geometry");
              return;
            }
    
            // Only geocodes have viewport
            if (place.geometry.viewport) {
              bounds.union(place.geometry.viewport);
            } else {
              bounds.extend(place.geometry.location);
            }
          });
          map.fitBounds(bounds);
          map.setTilt(0);
        });
        //*********************************** End search Box ***********************************
    
        //*********************************** Custom Controls***********************************
        function MapModeControl(divHolder) {
          // Set CSS for the control border.
          let controlUI = document.createElement("div");
          controlUI.style.backgroundColor = "#fff";
          controlUI.style.border = "2px solid #fff";
          controlUI.style.borderRadius = "3px";
          controlUI.style.cursor = "pointer";
          controlUI.style.marginTop = "0";
          controlUI.style.padding = "2px";
          controlUI.title = "Select Control Mode";
          controlUI.id = "mode-control-container";
    
          let modeText = document.createElement("div");
          modeText.innerHTML = "Mode: ";
          modeText.style.color = "rgb(25,25,25)";
          modeText.style.fontFamily = "Roboto,Arial,sans-serif";
          modeText.style.fontSize = "15px";
          modeText.style.lineHeight = "30px";
          modeText.style.marginRight = "10px";
          modeText.style.fontWeight = "600";
    
          // Interior
          let modeSelect = document.createElement("select");
          modeSelect.id = "mode-selector";
          modeSelect.style.color = "rgb(25,25,25)";
          modeSelect.style.fontFamily = "Roboto,Arial,sans-serif";
          modeSelect.style.fontSize = "15px";
          modeSelect.style.lineHeight = "30px";
    
          let mode;
          for (let i = 0; i < drawModeControl.modes.length; i++) {
            mode = document.createElement("option");
            mode.value = i;
            mode.text = drawModeControl.modes[i];
            mode.title = drawModeControl.hoverText[i];
            if (i === 5) {
              mode.id = "vra-auto-generation-mode";
              mode.disabled = true;
            }
            modeSelect.appendChild(mode);
          }
          modeSelect.addEventListener("change", function() {
            let index = modeSelect.selectedIndex;
            let value = modeSelect.options[index].value;
            drawToggle(value);
          });
    
          controlUI.appendChild(modeText);
          controlUI.appendChild(modeSelect);
          let searchButton = document.createElement("button");
          searchButton.type = "button";
          searchButton.id = "map-search-toggle";
          searchButton.title = "Search map";
          searchButton.setAttribute("aria-label", "Search map");
          searchButton.setAttribute("aria-controls", "pac-input");
          searchButton.setAttribute("aria-expanded", "false");
          searchButton.innerHTML = '<img src="https://cdn.jsdelivr.net/npm/lucide-static@0.468.0/icons/search.svg" width="18" height="18" alt="">';

          function setSearchExpanded(expanded) {
            let visible = expanded || input.value.trim().length > 0;
            input.hidden = !visible;
            searchButton.setAttribute("aria-expanded", String(visible));
          }

          searchButton.addEventListener("click", function() {
            setSearchExpanded(input.hidden);
            if (!input.hidden) {
              input.focus();
            }
          });
          input.addEventListener("blur", function(event) {
            if (event.relatedTarget !== searchButton) {
              setSearchExpanded(false);
            }
          });
          input.addEventListener("keydown", function(event) {
            if (event.key === "Escape") {
              setSearchExpanded(false);
              searchButton.focus();
            }
          });
          controlUI.appendChild(searchButton);
          controlUI.appendChild(input);
          divHolder.appendChild(controlUI);
        }
    
        /* Advanced Options Button and Tab*/
        let advancedOptions = document.getElementById('advanced-options');
    
        /* Map Modes Control */
        let modeSelectionDiv = document.createElement("div");
        MapModeControl(modeSelectionDiv);
        modeSelectionDiv.index = 1;
        map.controls[google.maps.ControlPosition.TOP_LEFT].push(modeSelectionDiv);
    
        /* Mobile Controls (Crosshair) */
        let mobileControl = document.getElementById("mobile-div");
        let mapControlStack = document.createElement("div");
        mapControlStack.id = "map-control-stack";
        document.querySelector(".map-container").appendChild(mapControlStack);

        let logoAlignmentScheduled = false;
        function alignControlStackWithGoogleLogo() {
          if (logoAlignmentScheduled) {
            return;
          }

          logoAlignmentScheduled = true;
          window.requestAnimationFrame(function() {
            logoAlignmentScheduled = false;
            let googleLogo = document.querySelector("#map img[alt='Google']");
            let mapBounds = document.getElementById("map").getBoundingClientRect();
            let logoBounds = googleLogo && googleLogo.getBoundingClientRect();
            if (!logoBounds || mapBounds.bottom - logoBounds.bottom > 20) {
              return;
            }

            let containerBounds = mapControlStack.parentElement.getBoundingClientRect();
            let bottom = Math.max(0, containerBounds.bottom - logoBounds.top + 10) + "px";
            if (mapControlStack.style.bottom !== bottom) {
              mapControlStack.style.bottom = bottom;
            }
          });
        }

        let mapLayoutObserver = new MutationObserver(alignControlStackWithGoogleLogo);
        mapLayoutObserver.observe(document.getElementById("map"), {
          attributes: true,
          attributeFilter: ["style"],
          childList: true,
          subtree: true
        });
        map.addListener("idle", alignControlStackWithGoogleLogo);
        map.addListener("tilesloaded", alignControlStackWithGoogleLogo);
        window.addEventListener("resize", alignControlStackWithGoogleLogo);
        window.requestAnimationFrame(alignControlStackWithGoogleLogo);

        /*  Dropup Menu With Additional Options */
        let dropUpMenuButton = $('<button>Options</button>')
              .attr({
                "data-toggle":"dropdown",
                "aria-haspopup":"true",
                "aria-expanded":"false"
              })
              .addClass("btn btn-white dropdown-toggle");

        let mapDisplaySubmenu = $('<div></div>').attr("id", "map-display-submenu");
        let mapDisplayToggle = $('<button type="button">Map display <span aria-hidden="true">&#9662;</span></button>')
          .attr({ id: "map-display-toggle", "aria-expanded": "false" })
          .addClass("dropdown-item map-display-toggle");
        let mapDisplayOptions = $('<div></div>').attr("id", "map-display-options");

        let locationIconToggle = $('<input type="checkbox" id="location-icon-toggle">')
          .prop("checked", !!userLocationMarker)
          .on("change", function(event) {
            event.stopPropagation();
            if (!userLocation) {
              this.checked = !!userLocationMarker;
              toggleLocationIcon();
              return;
            }
            toggleLocationIcon();
            this.checked = !!userLocationMarker;
          });
        mapDisplayOptions.append(
          $('<label class="map-display-row"><span>Location icon</span></label>').append(locationIconToggle)
        );

        let mapViewSelect = $('<select id="map-view-select"><option value="map">Map</option><option value="satellite">Satellite</option></select>')
          .val(mapDisplayView)
          .on("change", function(event) {
            event.stopPropagation();
            mapDisplayView = this.value;
            applyMapDisplaySettings();
          });
        mapDisplayOptions.append(
          $('<label class="map-display-row"><span>View</span></label>').append(mapViewSelect)
        );

        let mapLabelsToggle = $('<input type="checkbox" id="map-labels-toggle">')
          .prop("checked", mapLabelsVisible)
          .on("change", function(event) {
            event.stopPropagation();
            mapLabelsVisible = this.checked;
            applyMapDisplaySettings();
          });
        mapDisplayOptions.append(
          $('<label class="map-display-row"><span>Map labels</span></label>').append(mapLabelsToggle)
        );

        mapDisplayToggle.on("click", function(event) {
          event.preventDefault();
          event.stopPropagation();
          let expanded = mapDisplaySubmenu.hasClass("expanded");
          mapDisplaySubmenu.toggleClass("expanded", !expanded);
          $(this).attr("aria-expanded", String(!expanded));
        });
        mapDisplayOptions.on("click", function(event) {
          event.stopPropagation();
        });
        mapDisplaySubmenu.append(mapDisplayToggle, mapDisplayOptions);

        let dropUpMenuContent = $('<div></div>')
            .attr({
              'id':"dropUpMenuButtons"
            })
            .addClass("dropdown-menu")
            .append($('<button>Center on App Area</button>').click(centerMap).attr({"id":"center-btn"}).addClass("dropdown-item"))
            .append($('<button>Clear Drawings</button>').click(resetMap).attr({"id":"reset-btn"}).addClass("dropdown-item"))
            .append($('<button>Import Overlay</button>').click(importOverlay).attr({"id":"import-btn"}).addClass("dropdown-item"))
            .append(mapDisplaySubmenu)
            .append($('<div class="dropdown-divider"></div>').addClass("overlay-visible-item"))
            .append($('<button>Center on Overlays</button>').click(() => { if (overlayManager){ overlayManager.setMapBoundsToAllLayers()} }).attr({"id":"center-btn"}).addClass("dropdown-item overlay-visible-item"))
            .append($('<button>Clear Overlays</button>').click(() => { if (overlayManager){ overlayManager.removeAllLayers()} }).addClass("dropdown-item overlay-visible-item"));
        
        let dropUpMenu = $('<div></div>').attr({"id":"maps-options"}).addClass("btn-group dropup").append(dropUpMenuButton).append(dropUpMenuContent);
        dropUpMenu.on("hidden.bs.dropdown", function() {
          mapDisplaySubmenu.removeClass("expanded");
          mapDisplayToggle.attr("aria-expanded", "false");
        });
        mapControlStack.appendChild(dropUpMenu[0]);
        mapControlStack.appendChild(mobileControl);
        //********************************* End Custom Controls*********************************

        // Show color magnification if overlay exists and in vra auto generation mode
        google.maps.event.addListener(map, "mousemove", function (event) {
          magnifierMove(event);
        });

        google.maps.event.addListener(map, "mouseout", function(event) {
          hideMagnifier();
        });
      }

      function autoGenerateVRAsFromSelection(event) {
        if (document.getElementById('mobile-mode').checked && !event.isCrosshairClick) { return; }
        if (!!overlayManager && overlayManager.hasLayers() && vraAutoGenerationEnabled) {
          overlayManager.generateVRAsFromOverlayLatLngSelection(event.latLng, !!appArea);
        }
      }

      function hideMagnifier() {
        if (magnifyingGlass) {
          magnifyingGlass.style.display = "none";
        }
      }

      function magnifierMove(event) {
        if (!(!!overlayManager && overlayManager.hasLayers() && vraAutoGenerationEnabled)) { return; }
        if (updatingMagnifier) { return; }

        // Create magnifier (if not already existing) and display it
        if (!magnifyingGlass) {
          magnifyingGlass = document.createElement("div");
          magnifyingGlass.setAttribute("class", "img-magnifier-glass");
          document.getElementById('map').parentElement.insertBefore(magnifyingGlass, document.getElementById('map'));
        }
        magnifyingGlass.style.display = "block";
        let x, y, latLng;
        updatingMagnifier = true;
        if (document.getElementById('mobile-mode').checked) {
          // Update magnifier based on draggable google maps marker position
          // Calculate marker position on screen from map location
          const scale = Math.pow(2, map.getZoom());
          const nw = new google.maps.LatLng(
              map.getBounds().getNorthEast().lat(),
              map.getBounds().getSouthWest().lng()
          );
          const worldCoordinateNW = map.getProjection().fromLatLngToPoint(nw);
          const worldCoordinate = map.getProjection().fromLatLngToPoint(centerMarker.getPosition());
          // Adjust the magnifiers position to not overlap with the marker
          x = Math.floor((worldCoordinate.x - worldCoordinateNW.x) * scale) + 40;
          y = Math.floor((worldCoordinate.y - worldCoordinateNW.y) * scale) - 80;
          latLng = centerMarker.getPosition();
        } else {
          // Update magnifier based on mouse (and touch?) position
          latLng = event.latLng;
          x = (event.domEvent.clientX == null) ? event.domEvent.touches[0].clientX : event.domEvent.clientX;
          y = (event.domEvent.clientY == null) ? event.domEvent.touches[0].clientY : event.domEvent.clientY;
        }
        x = ((x < 0) || !x) ? 0: x;
        y = ((y < 0) || !y) ? 0: y;
        magnifyingGlass.style.left = (x+5)+"px";
        magnifyingGlass.style.top = (y+5)+"px";
        if (!!overlayManager && overlayManager.hasLayers()) {
          magnifyingGlass.style.backgroundColor = overlayManager.getColorAtLatLng(latLng);
        }
        updatingMagnifier = false
      }
      
      function setOverlayVisibility(isVisible) {
        if (overlayManager) { overlayManager.setVisibility(isVisible); }
      }

      function importOverlayFromLoader() {
        if (overlayManager) {
          closeOverlayLoader();
          createAlert("Importing Overlay . . .", 3000,"info", (finished) => {
            overlayManager.importOverlayFromLoader((success) => {
              if (success) {
                createAlert("Overlay imported Successfully", 3000,"success");
              } else {
                createAlert("Failed to Import Overlay", 3000,"error");
              }
            });
          });
        }
      }

      function makeMarker() {
        if (drawModeControl.current == 5) {
          // VRA Auto Generation Mode
          autoGenerateVRAsFromSelection({ 'isCrosshairClick': true, 'latLng': centerMarker.getPosition()});
          return;
        }
        if (drawModeControl.current == 4) {
          // Delete Mode
          mobileClickSubPoly(centerMarker.getPosition());
          return;
        }
        if (drawModeControl.current == 0) {
          // Drag Mode
          alert("Select a mode.");
          return;
        }
    
        overlayMarkers.push(centerMarker.getPosition());
        if (tempShape != null) {
          tempShape.setMap(null);
        }
        if (overlayMarkers.length == 1) {
          tempShape = new google.maps.Marker({
            position: centerMarker.getPosition(),
            icon: {
              path: google.maps.SymbolPath.CIRCLE,
              scale: 6,
              fillColor: "white",
              fillOpacity: 1,
              strokeColor: "black",
              strokeWeight: 2
            },
            map: map
          });
          return;
        }
    
        // If more than one marker, generate a polyline
        tempShape = new google.maps.Polyline({
          path: overlayMarkers,
          strokeColor: "#000000",
          strokeOpacity: 1,
          strokeWeight: 3,
          draggable: true,
          geodesic: true
        });
        tempShape.setMap(map);
      }
    
      function mobileClickSubPoly(latLng) {
        if (appArea == null) {
          return;
        }
        // Mobile delete selection fix
        let temp;
        for (let i = 0; i < appArea.getNumHazard(); i++) {
          temp = appArea.getHazard(i).getPoly();
          if (google.maps.geometry.poly.containsLocation(latLng, temp)) {
            let mev = {
              stop: null,
              latLng: latLng
            };
            google.maps.event.trigger(temp, "click", mev);
            return;
          }
        }
        for (let i = 0; i < appArea.getNumVariableRateAreas(); i++) {
          temp = appArea.getVariableRateArea(i).getPoly();
          if (google.maps.geometry.poly.containsLocation(latLng, temp)) {
            let mev = {
              stop: null,
              latLng: latLng
            };
            google.maps.event.trigger(temp, "click", mev);
            return;
          }
        }
        console.log("No subpoly contained spot");
      }
    
      function promptAndDelete(identifier) {
          // Named instance variable for AppArea is assumed to be appArea
          // check if drawing mode is set to delete
          if (drawModeControl.getCurrent() != "Delete") { return; } // also instanced variable (drawModeControl)

          if (appArea == null) { return; }
          var index = appArea.getIndexOfIdentifier(identifier.id, identifier.type);
          if (index == -1) { return; }
          var centroid;

          if (identifier.type == "hazard") {
              centroid = appArea.getHazard(index).getCentroid();
          } else if (identifier.type == "variable") {
              centroid = appArea.getVariableRateArea(index).getCentroid();
          } else { return; }

          // function to clear markers and infowindow
          appArea.resetGlobals();

          appArea.deleteIdentifier = identifier;

          var marker = new google.maps.Marker({
              position: centroid,
              map: appArea.getMap()
          });

          var infoWindow = new google.maps.InfoWindow({ content: "" });


          // Couldn't pass values easily in content string, utilizing global variable instead
          infoWindow.setContent('<button type="button" onClick="deleteSubPoly()">Delete</button>');
          google.maps.event.addListener(infoWindow, 'closeclick', function () {
              appArea.resetGlobals();
          });

          infoWindow.open(appArea.getMap(), marker);
          appArea.marker = marker;
          appArea.infoWindow = infoWindow;
      }

      function resetDisplaySettings() {
        const appAreaColor = "#FFFF00";
        const appAreaOpacity = 0.6;
        const hazardAreaColor = "#FF0000";
        const hazardAreaOpacity = 0.7;
        const vrAreaColor = "#CCCCCC";
        const vrAreaOpacity = 0.6;
    
        $('#app-area-color').val(appAreaColor);
        $('#app-area-opacity').val(appAreaOpacity * 100);
        $('#app-area-opacity-display').text((appAreaOpacity * 100) + "%");
        $('#hazard-area-color').val(hazardAreaColor);
        $('#hazard-area-opacity').val(hazardAreaOpacity * 100);
        $('#hazard-area-opacity-display').text((hazardAreaOpacity * 100) + "%");
        $('#vr-area-color').val(vrAreaColor);
        $('#vr-area-opacity').val(vrAreaOpacity * 100);
        $('#vr-area-opacity-display').text((vrAreaOpacity * 100) + "%");
        updateDrawSettingSummaries();
    
        try {
          if (appArea) {
            appArea.poly.setOptions({
              fillColor: appAreaColor,
              fillOpacity: appAreaOpacity
            });
            for(let i = 0; i < appArea.getNumHazard(); i++) {
              appArea.getHazard(i).poly.setOptions({
                fillColor: hazardAreaColor,
                fillOpacity: hazardAreaOpacity
              });
            }
            for(let i = 0; i < appArea.getNumVariableRateAreas(); i++) {
              appArea.getVariableRateArea(i).poly.setOptions({
                fillColor: vrAreaColor,
                fillOpacity: vrAreaOpacity
              });
            }
          }
          // Static Values
          AppArea.fill = appAreaColor;
          AppArea.opacity = appAreaOpacity;
          AppArea.hazardFill = hazardAreaColor;
          AppArea.hazardOpacity = hazardAreaOpacity;
          AppArea.vrFill = vrAreaColor;
          AppArea.vrOpacity = vrAreaOpacity;
        } catch (e) {
          console.log("Error when resetting custom drawing display settings: " + e.message);
        }
        updateTerraDrawPreviewStyles(drawModeControl.current);
      }
    
