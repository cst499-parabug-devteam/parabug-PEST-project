      function showHelp(topic = "drawing", anchorId = null) {
        selectHelpTab(document.getElementById("help-" + topic + "-tab"));
        if (!helpDialog.open) {
          helpDialog.showModal();
        }
        helpDialog.scrollTop = 0;
        if (anchorId) {
          let anchor = document.getElementById(anchorId);
          let fieldHelp = anchor.closest(".help-field");
          fieldHelp.classList.add("is-highlighted");
          fieldHelp.scrollIntoView({ block: "start" });
          anchor.focus({ preventScroll: true });
          window.requestAnimationFrame(function() {
            if (helpDialog.open && document.activeElement === anchor) {
              fieldHelp.scrollIntoView({ block: "start" });
            }
          });
        }
      }

      const helpDialog = document.getElementById("help-dialog");
      const helpTabs = Array.from(helpDialog.querySelectorAll('[role="tab"]'));
      helpDialog.addEventListener("keydown", function(event) {
        if (event.key === "Escape") {
          event.preventDefault();
          helpDialog.close();
        }
      });
      function selectHelpTab(selectedTab) {
        helpDialog.querySelectorAll(".help-field.is-highlighted").forEach(function(fieldHelp) {
          fieldHelp.classList.remove("is-highlighted");
        });
        helpTabs.forEach(function(tab) {
          let selected = tab === selectedTab;
          tab.setAttribute("aria-selected", String(selected));
          tab.tabIndex = selected ? 0 : -1;
          document.getElementById(tab.getAttribute("aria-controls")).hidden = !selected;
        });
        helpDialog.scrollTop = 0;
      }
      helpTabs.forEach(function(tab, index) {
        tab.addEventListener("click", function() { selectHelpTab(tab); });
        tab.addEventListener("keydown", function(event) {
          let nextIndex;
          switch (event.key) {
            case "ArrowRight": nextIndex = (index + 1) % helpTabs.length; break;
            case "ArrowLeft": nextIndex = (index + helpTabs.length - 1) % helpTabs.length; break;
            case "Home": nextIndex = 0; break;
            case "End": nextIndex = helpTabs.length - 1; break;
            default: return;
          }
          event.preventDefault();
          selectHelpTab(helpTabs[nextIndex]);
          helpTabs[nextIndex].focus();
        });
      });
      helpDialog.addEventListener("click", function(event) {
        if (event.target !== helpDialog) { return; }
        let bounds = helpDialog.getBoundingClientRect();
        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) {
          helpDialog.close();
        }
      });

      function showPrompt(id, data = null) {
        if (id === "shortcuts") {
          showHelp("shortcuts");
          return;
